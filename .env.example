# ============================================================
# Athar Al 'Ilm — Environment Variables Template
# Copy this to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# ============================================================

# Django
SECRET_KEY=change-this-to-a-long-random-string-at-least-50-chars
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production
ALLOWED_HOSTS=atharulilm.or.tz,www.atharulilm.or.tz,localhost

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://atharulilm.or.tz,https://atharulilm.or.tz

# MongoDB
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB_NAME=tadabbur
MONGO_USERNAME=tadabbur_user
MONGO_PASSWORD=change-this-strong-mongo-password

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO (self-hosted S3)
# For Docker local dev: MINIO_ENDPOINT=http://minio:9000, MINIO_PUBLIC_URL=http://localhost:9000
# For external MinIO:   MINIO_ENDPOINT=https://s3.yourdomain.com, MINIO_PUBLIC_URL=https://s3.yourdomain.com
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=change-this-minio-access-key
MINIO_SECRET_KEY=change-this-minio-secret-key
MINIO_BUCKET_NAME=tadabbur-media
MINIO_ASSETS_BUCKET=tadabbur-assets

# YouTube (for the Videos feature)
# Get from: https://console.cloud.google.com/ → YouTube Data API v3
YOUTUBE_API_KEY=your-youtube-data-api-v3-key-here
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini (AI lesson translation) — OPTIONAL fallback.
# Preferred: set this from the admin panel (Admin → Languages). This env var is
# only used when the admin-stored key is empty. Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Email / SMTP (Email Marketing + transactional)
# Preferred production path: Resend SMTP (domain atharulilm.or.tz already verified).
# Admin panel → Email → Settings can also store these (password masked).
# Inbox for ops / replies: ops@atharulilm.or.tz (Resend inbox; MX must be set).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_USE_TLS=False
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_xxx   # Resend API key — host secrets only, never commit
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Athar Al Ilm <ops@atharulilm.or.tz>
# Optional direct Resend HTTP API (future); SMTP above is enough for Django.
# RESEND_API_KEY=

# Google sign-in (Identity Services ID token). Public client id — no secret.
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# → Web application. Authorized JavaScript origins:
#   https://atharulilm.or.tz
#   https://www.atharulilm.or.tz
#   http://localhost:5173
#   http://127.0.0.1:5173
# Authorized redirect URIs: leave empty (the SPA posts the ID token to
# POST /api/v1/auth/google/; Google does not redirect the browser).
# Set the same value on Contabo /opt/athar-tadabbur/.env and restart backend.
# The login page reads it from GET /api/v1/auth/google/config/ — no Vite rebuild.
GOOGLE_CLIENT_ID=

# GitHub deploy trigger — auto-rebuild the prerendered frontend when content is
# published. Fine-grained PAT scoped to this repo, "Actions: Read and write".
# Leave blank to disable auto-rebuild (content then goes live on the next deploy).
GITHUB_DEPLOY_TOKEN=
GITHUB_REPO=atomicbaassas/Athar-Al-Ilm

# Frontend (Vite env vars — prefixed VITE_ to be exposed to browser)
VITE_API_BASE_URL=/api/v1
