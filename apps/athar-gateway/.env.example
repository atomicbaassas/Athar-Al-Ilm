ATHAR_GATEWAY_HOST=127.0.0.1
ATHAR_GATEWAY_PORT=9091
ATHAR_FETCH_TIMEOUT_MS=20000
# Required for /v1/islamhouse/* — host secrets only, no committed fallback
ISLAMHOUSE_API_KEY=
# Comma-separated browser origins allowed for CORS (same-origin via nginx needs none)
ATHAR_CORS_ORIGINS=https://atharulilm.or.tz,https://www.atharulilm.or.tz,http://localhost:5173,http://127.0.0.1:5173
