ATHAR_GATEWAY_HOST=127.0.0.1
ATHAR_GATEWAY_PORT=9091
ATHAR_FETCH_TIMEOUT_MS=20000
# Preferred: Admin → Integrations via Django internal keys URL (same token as backend).
# Use the public HTTPS origin in prod (loopback :8080 is redirected by SECURE_SSL_REDIRECT).
ATHAR_KEYS_URL=https://atharulilm.or.tz/api/v1/integrations/internal/keys/
ATHAR_INTERNAL_TOKEN=
ATHAR_KEYS_TTL_MS=60000
# Fallbacks when Admin Integrations / keys URL unavailable — host secrets only
ISLAMHOUSE_API_KEY=
DORAR_API_KEY=
# Comma-separated browser origins allowed for CORS (same-origin via nginx needs none)
ATHAR_CORS_ORIGINS=https://atharulilm.or.tz,https://www.atharulilm.or.tz,http://localhost:5173,http://127.0.0.1:5173
